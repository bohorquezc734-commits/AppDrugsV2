{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AppDrugsV2;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "TuSuperSecretKeyDeAlMenos32CaracteresLargos1234567",
    "Issuer": "AppDrugsV2",
    "Audience": "AppDrugsV2Client",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/appdrugs-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "RateLimiting": {
    "AuthLoginPermitLimit": 5,
    "AuthLoginWindowSeconds": 60,
    "AuthForgotPasswordPermitLimit": 3,
    "AuthForgotPasswordWindowSeconds": 300
  },
  "AllowedHosts": "*"
}